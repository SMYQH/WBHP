{
  "name": "wbhp",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "WBHP - Web Browser Home Page. A modern, pluggable browser new tab extension.",
  "author": "WBHP Contributors",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:firefox": "cross-env BROWSER=firefox vite",
    "build": "tsc -b && vite build",
    "build:firefox": "tsc -b && cross-env BROWSER=firefox vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:all": "npm run build && npm run build:firefox"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "cross-env": "^7.0.3",
    "crx3": "^2.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=24"
  }
}
