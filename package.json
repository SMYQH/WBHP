{
  "name": "wbhp",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "description": "WBHP - Web Browser Home Page. A modern, pluggable browser new tab extension.",
  "author": "WBHP Contributors",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:firefox": "cross-env BROWSER=firefox vite",
    "build": "tsc -b && vite build",
    "build:firefox": "tsc -b && cross-env BROWSER=firefox vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:all": "npm run build && npm run build:firefox",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "cross-env": "^7.0.3",
    "crx3": "^2.0.0",
    "jsdom": "^30.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
