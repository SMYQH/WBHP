{
  "manifest_version": 3,
  "name": "WBHP",
  "version": "0.5.17",
  "description": "Web Browser Home Page — A modern, pluggable new tab page.",
  "author": "WBHP Contributors",
  "browser_specific_settings": {
    "gecko": {
      "id": "wbhp@example.com",
      "strict_min_version": "109.0",
      "update_url": "https://raw.githubusercontent.com/SMYQH/wbhp/master/updates-firefox.json"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "alarms"]
}
